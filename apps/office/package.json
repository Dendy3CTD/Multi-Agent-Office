{
  "name": "@open-agent-office/office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "desktop:run": "corepack pnpm build && electron electron/main.cjs",
    "desktop:dev": "electron electron/main.cjs --dev",
    "test:desktop": "node --test electron/window-layout.check.cjs",
    "test:animations": "python3 ../../scripts/check_animation_sheets.py",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.2.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
